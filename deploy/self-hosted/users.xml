<clickhouse>
  <users>
    <maple_reader>
      <password from_env="MAPLE_CH_READ_PASSWORD" />
      <networks><ip>::/0</ip></networks>
      <profile>default</profile><quota>default</quota>
      <grants>
        <query>GRANT SELECT ON maple.*</query>
        <query>GRANT SELECT ON system.columns</query>
        <query>GRANT SELECT ON system.data_skipping_indices</query>
        <query>GRANT SELECT ON system.settings</query>
      </grants>
    </maple_reader>
    <maple_writer>
      <password from_env="MAPLE_CH_WRITE_PASSWORD" />
      <networks><ip>::/0</ip></networks>
      <profile>default</profile><quota>default</quota>
      <grants>
        <query>GRANT SELECT, INSERT ON maple.*</query>
        <query>GRANT CREATE TEMPORARY TABLE ON *.*</query>
      </grants>
    </maple_writer>
  </users>
</clickhouse>
