# Public HTTPS origin, without a trailing slash.
MAPLE_PUBLIC_URL=https://maple.example.com

# Use a different `openssl rand -hex 32` value for each password/token.
# Keep POSTGRES_PASSWORD URL-safe (hex), since it is used in DATABASE_URL.
POSTGRES_PASSWORD=
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_READ_PASSWORD=
CLICKHOUSE_WRITE_PASSWORD=
MAPLE_ROOT_PASSWORD=
INTERNAL_SERVICE_TOKEN=

# Use a different `openssl rand -base64 32` value for each key.
MAPLE_INGEST_KEY_ENCRYPTION_KEY=
MAPLE_INGEST_KEY_LOOKUP_HMAC_KEY=
MAPLE_SHARE_TOKEN_HMAC_KEY=

# Existing Maple agent provider. This key stays in the server container.
OPENROUTER_API_KEY=
# Optional: an OpenRouter model that supports tools.
MAPLE_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017:nitro
